# API-Key from https://data-library.smartcity.hn (My apps). Sent as x-apikey.
SMARTCITY_API_KEY=

# Optional alias (same value as SMARTCITY_API_KEY)
SMARTCITY_CLIENT_ID=

# Optional URL overrides (defaults are the published Data Library gateways)
SMARTCITY_WEATHER_URL=https://apis.smartcity.hn/bildungscampus/iotplatform/weatherstation/v1
SMARTCITY_THM_URL=https://apis.smartcity.hn/bildungscampus/iotplatform/thm/v1
SMARTCITY_MENSA_URL=https://apis.smartcity.hn/bildungscampus/smartcampus/mensamenu/v1
